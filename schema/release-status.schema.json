{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "approval": {
      "type": "object",
      "properties": {
        "at": {
          "type": "string",
          "minLength": 1
        },
        "release_date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      },
      "required": [
        "at",
        "release_date"
      ]
    },
    "items": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "done": {
            "default": false,
            "type": "boolean"
          },
          "at": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "by": {
            "type": "string",
            "enum": [
              "user",
              "autopilot"
            ]
          },
          "manual": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "required": [
    "version"
  ]
}
