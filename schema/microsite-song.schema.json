{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "slug": {
      "type": "string",
      "minLength": 1
    },
    "artist": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "language": {
      "type": "string"
    },
    "release_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "teaser": {
      "type": "string"
    },
    "text": {
      "type": "string"
    },
    "quote": {
      "type": "string"
    },
    "lyrics": {
      "type": "string"
    },
    "images": {
      "type": "object",
      "properties": {
        "cover": {
          "type": "string"
        },
        "thumbnail": {
          "type": "string"
        },
        "shorts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "shorts"
      ]
    },
    "aspect": {
      "type": "string",
      "enum": [
        "16:9",
        "9:16",
        "4:5",
        "1:1"
      ]
    },
    "links": {
      "type": "object",
      "properties": {
        "youtube": {
          "type": "string"
        },
        "spotify": {
          "type": "string"
        },
        "tiktok": {
          "type": "string"
        },
        "instagram": {
          "type": "string"
        },
        "x": {
          "type": "string"
        },
        "linkedin": {
          "type": "string"
        }
      }
    },
    "shorts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "links": {
            "type": "object",
            "properties": {
              "youtube": {
                "type": "string"
              },
              "tiktok": {
                "type": "string"
              },
              "instagram": {
                "type": "string"
              },
              "x": {
                "type": "string"
              }
            }
          }
        },
        "required": [
          "name",
          "links"
        ]
      }
    },
    "profiles": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "disclosure": {
      "type": "string"
    },
    "credits": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "version",
    "slug",
    "title",
    "language",
    "images",
    "links",
    "shorts",
    "profiles",
    "disclosure",
    "credits"
  ]
}
