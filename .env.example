# Copy to .env and fill in the values you need.
# The mock provider and the motion-only demo need no secrets.

# fal.ai image/video generation
FAL_KEY=

# Optional: only if you prefer API speech recognition over local WhisperX
OPENAI_API_KEY=

# Optional: gated Hugging Face models (some Demucs/WhisperX assets)
HF_TOKEN=

# Suno MCP endpoint (OAuth is handled by Claude Code's MCP login)
SUNO_MCP_URL=https://api.suno.com/mcp

# Audio analysis
DEMUCS_DEVICE=auto
DEMUCS_MODEL=htdemucs_ft
WHISPER_MODEL=large-v3

# Cost guard defaults (project.yaml always wins)
DEFAULT_BATCH_CAP_RATIO=0.30
