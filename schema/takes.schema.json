{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "default": 1,
      "type": "number",
      "const": 1
    },
    "takes": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[a-z0-9][a-z0-9_-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string",
            "enum": [
              "generated",
              "imported"
            ]
          },
          "duration": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "text_hash": {
            "type": "string",
            "minLength": 1
          },
          "file_hash": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "source",
          "duration",
          "text_hash"
        ]
      }
    },
    "ambience": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[a-z0-9][a-z0-9_-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string",
            "enum": [
              "generated",
              "imported"
            ]
          },
          "duration": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "text_hash": {
            "type": "string",
            "minLength": 1
          },
          "file_hash": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "source",
          "duration",
          "text_hash"
        ]
      }
    }
  }
}
