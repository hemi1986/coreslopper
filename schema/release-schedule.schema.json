{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "timezone": {
      "type": "string",
      "minLength": 1
    },
    "release": {
      "default": {},
      "type": "object",
      "properties": {
        "weekday": {
          "default": "fri",
          "type": "string",
          "enum": [
            "mon",
            "tue",
            "wed",
            "thu",
            "fri",
            "sat",
            "sun"
          ]
        },
        "song_time": {
          "default": "00:00",
          "type": "string",
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
        },
        "video_time": {
          "default": "18:00",
          "type": "string",
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
        },
        "premiere": {
          "default": true,
          "type": "boolean"
        },
        "min_gap_weeks": {
          "default": 1,
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "lead_days": {
          "default": 21,
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "skip": {
          "default": [
            "12-24",
            "12-25",
            "12-26",
            "12-31",
            "01-01"
          ],
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(\\d{4}-)?\\d{2}-\\d{2}$"
          }
        }
      }
    },
    "steps": {
      "default": {},
      "type": "object",
      "properties": {
        "distributor": {
          "default": -21,
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 0
        },
        "pitch": {
          "default": -14,
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": -7
        },
        "announce": {
          "default": -7,
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": -1
        },
        "canvas": {
          "default": -7,
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 0
        },
        "links": {
          "default": 1,
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "task_time": {
          "default": "10:00",
          "type": "string",
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
        }
      }
    },
    "shorts": {
      "default": {},
      "type": "object",
      "properties": {
        "weekdays": {
          "default": [
            "mon",
            "wed",
            "fri"
          ],
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "mon",
              "tue",
              "wed",
              "thu",
              "fri",
              "sat",
              "sun"
            ]
          }
        },
        "times": {
          "default": {},
          "type": "object",
          "properties": {
            "youtube": {
              "default": "18:00",
              "type": "string",
              "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
            },
            "tiktok": {
              "default": "20:00",
              "type": "string",
              "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
            },
            "instagram": {
              "default": "20:00",
              "type": "string",
              "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
            },
            "x": {
              "default": "18:00",
              "type": "string",
              "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
            }
          }
        },
        "per_song_per_week": {
          "default": 1,
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "first_on_release_day": {
          "default": true,
          "type": "boolean"
        }
      }
    },
    "posts": {
      "default": {},
      "type": "object",
      "properties": {
        "instagram": {
          "default": "20:00",
          "type": "string",
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
        },
        "x": {
          "default": "18:00",
          "type": "string",
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
        },
        "linkedin_weekday": {
          "default": "tue",
          "type": "string",
          "enum": [
            "mon",
            "tue",
            "wed",
            "thu",
            "fri",
            "sat",
            "sun"
          ]
        },
        "linkedin_time": {
          "default": "09:00",
          "type": "string",
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
        }
      }
    },
    "booked": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "kind": {
            "default": "short",
            "type": "string",
            "enum": [
              "release",
              "short"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "date",
          "label"
        ]
      }
    }
  },
  "required": [
    "version"
  ]
}
