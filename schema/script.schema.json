{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "title": {
      "type": "string"
    },
    "chat": {
      "type": "object",
      "properties": {
        "cps": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "hold": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "cps",
        "hold"
      ]
    },
    "scenes": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "set": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "atmo": {
            "type": "string"
          },
          "lines": {
            "minItems": 1,
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "dialogue"
                    },
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^[a-z0-9][a-z0-9_-]*$"
                    },
                    "with": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^[a-z0-9][a-z0-9_-]*$"
                    },
                    "speaker": {
                      "type": "string",
                      "minLength": 1
                    },
                    "text_de": {
                      "type": "string",
                      "minLength": 1
                    },
                    "text_en": {
                      "type": "string"
                    },
                    "direction": {
                      "type": "string"
                    },
                    "pause_after": {
                      "default": 0,
                      "type": "number",
                      "minimum": 0
                    }
                  },
                  "required": [
                    "kind",
                    "id",
                    "speaker",
                    "text_de"
                  ]
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "voiceover"
                    },
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^[a-z0-9][a-z0-9_-]*$"
                    },
                    "with": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^[a-z0-9][a-z0-9_-]*$"
                    },
                    "speaker": {
                      "type": "string",
                      "minLength": 1
                    },
                    "text_de": {
                      "type": "string",
                      "minLength": 1
                    },
                    "text_en": {
                      "type": "string"
                    },
                    "direction": {
                      "type": "string"
                    },
                    "pause_after": {
                      "default": 0,
                      "type": "number",
                      "minimum": 0
                    }
                  },
                  "required": [
                    "kind",
                    "id",
                    "speaker",
                    "text_de"
                  ]
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "announcement"
                    },
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^[a-z0-9][a-z0-9_-]*$"
                    },
                    "with": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^[a-z0-9][a-z0-9_-]*$"
                    },
                    "speaker": {
                      "type": "string",
                      "minLength": 1
                    },
                    "text_de": {
                      "type": "string",
                      "minLength": 1
                    },
                    "text_en": {
                      "type": "string"
                    },
                    "direction": {
                      "type": "string"
                    },
                    "pause_after": {
                      "default": 0,
                      "type": "number",
                      "minimum": 0
                    }
                  },
                  "required": [
                    "kind",
                    "id",
                    "speaker",
                    "text_de"
                  ]
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "chat"
                    },
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^[a-z0-9][a-z0-9_-]*$"
                    },
                    "with": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^[a-z0-9][a-z0-9_-]*$"
                    },
                    "speaker": {
                      "type": "string",
                      "minLength": 1
                    },
                    "text_de": {
                      "type": "string",
                      "minLength": 1
                    },
                    "text_en": {
                      "type": "string"
                    },
                    "pause_after": {
                      "default": 0,
                      "type": "number",
                      "minimum": 0
                    }
                  },
                  "required": [
                    "kind",
                    "id",
                    "speaker",
                    "text_de"
                  ]
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "sfx"
                    },
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^[a-z0-9][a-z0-9_-]*$"
                    },
                    "with": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^[a-z0-9][a-z0-9_-]*$"
                    },
                    "prompt": {
                      "type": "string",
                      "minLength": 1
                    },
                    "duration": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "pause_after": {
                      "default": 0,
                      "type": "number",
                      "minimum": 0
                    }
                  },
                  "required": [
                    "kind",
                    "id",
                    "prompt",
                    "duration"
                  ]
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "pause"
                    },
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^[a-z0-9][a-z0-9_-]*$"
                    },
                    "with": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^[a-z0-9][a-z0-9_-]*$"
                    },
                    "duration": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    }
                  },
                  "required": [
                    "kind",
                    "id",
                    "duration"
                  ]
                }
              ]
            }
          }
        },
        "required": [
          "id",
          "set",
          "description",
          "lines"
        ]
      }
    }
  },
  "required": [
    "version",
    "scenes"
  ]
}
