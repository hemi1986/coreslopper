{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "slug": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "kind": {
      "default": "music-video",
      "type": "string",
      "enum": [
        "music-video",
        "episode"
      ]
    },
    "series": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "episode": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "created": {
      "type": "string",
      "minLength": 1
    },
    "workflow": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "string"
        }
      },
      "required": [
        "version"
      ]
    },
    "budget_usd": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "batch_cap_usd": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "review_mode": {
      "default": "auto",
      "type": "string",
      "enum": [
        "auto",
        "final"
      ]
    },
    "formats": {
      "type": "object",
      "properties": {
        "master": {
          "type": "object",
          "properties": {
            "aspect": {
              "type": "string",
              "minLength": 1
            },
            "width": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "height": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "fps": {
              "default": 30,
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "aspect",
            "width",
            "height"
          ]
        },
        "derivatives": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "aspect": {
                "type": "string",
                "minLength": 1
              },
              "width": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "height": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "fps": {
                "default": 30,
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "aspect",
              "width",
              "height"
            ]
          }
        }
      },
      "required": [
        "master"
      ]
    },
    "providers": {
      "default": {
        "image": "mock",
        "video": "mock"
      },
      "type": "object",
      "properties": {
        "image": {
          "default": "mock",
          "type": "string",
          "enum": [
            "fal",
            "higgsfield",
            "topview",
            "comfyui",
            "mock"
          ]
        },
        "video": {
          "default": "mock",
          "type": "string",
          "enum": [
            "fal",
            "higgsfield",
            "topview",
            "comfyui",
            "mock"
          ]
        },
        "lipsync": {
          "type": "string",
          "enum": [
            "fal",
            "higgsfield",
            "topview",
            "comfyui",
            "mock"
          ]
        },
        "audio": {
          "type": "string",
          "enum": [
            "comfyui",
            "mock"
          ]
        }
      }
    },
    "brand": {
      "default": "example",
      "type": "string",
      "minLength": 1
    },
    "models": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "release": {
      "type": "object",
      "properties": {
        "distributor": {
          "default": "manual",
          "type": "string",
          "enum": [
            "distrokid",
            "manual"
          ]
        },
        "artist": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "featured_artists": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "primary_genre": {
          "type": "string",
          "minLength": 1
        },
        "secondary_genre": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "type": "string",
          "minLength": 2
        },
        "explicit": {
          "type": "boolean"
        },
        "release_date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "songwriters": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "producer": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "isrc": {
          "type": "string",
          "pattern": "^[A-Z]{2}-?[A-Z0-9]{3}-?\\d{2}-?\\d{5}$"
        },
        "ai_credits": {
          "type": "object",
          "properties": {
            "lyrics": {
              "type": "string",
              "enum": [
                "none",
                "partial",
                "full"
              ]
            },
            "music": {
              "type": "string",
              "enum": [
                "none",
                "partial",
                "full"
              ]
            },
            "vocals": {
              "type": "string",
              "enum": [
                "none",
                "partial",
                "full"
              ]
            },
            "instrumental": {
              "type": "string",
              "enum": [
                "none",
                "partial",
                "full"
              ]
            }
          }
        },
        "ai_tool": {
          "type": "string",
          "minLength": 1
        },
        "license_note": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "required": [
    "version",
    "slug",
    "title",
    "created",
    "workflow",
    "budget_usd",
    "formats"
  ]
}
