{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "tagline": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "type": "string",
      "minLength": 2
    },
    "links": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "handle": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "footer": {
      "default": {},
      "type": "object",
      "properties": {
        "tool_credit": {
          "type": "string",
          "minLength": 1
        },
        "song_credit": {
          "type": "string",
          "minLength": 1
        },
        "links": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "hashtag_sets": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^#[\\p{L}\\p{N}_]+$"
        }
      }
    },
    "limits": {
      "default": {},
      "type": "object",
      "properties": {
        "youtube": {
          "type": "object",
          "properties": {
            "title": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "description_bytes": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "tags": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "hashtags": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          }
        },
        "instagram": {
          "type": "object",
          "properties": {
            "caption": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "hashtags": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          }
        },
        "tiktok": {
          "type": "object",
          "properties": {
            "caption": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "hashtags": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          }
        },
        "spotify": {
          "type": "object",
          "properties": {
            "pitch": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          }
        },
        "x": {
          "type": "object",
          "properties": {
            "post": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "hashtags": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          }
        },
        "linkedin": {
          "type": "object",
          "properties": {
            "post": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "hook": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "hashtags": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          }
        }
      }
    },
    "disclosure": {
      "default": {},
      "type": "object",
      "properties": {
        "youtube_synthetic": {
          "default": true,
          "type": "boolean"
        },
        "tiktok_ai_label": {
          "default": true,
          "type": "boolean"
        },
        "instagram_ai_label": {
          "default": true,
          "type": "boolean"
        },
        "distributor_ai_credits": {
          "default": true,
          "type": "boolean"
        }
      }
    }
  },
  "required": [
    "version",
    "name",
    "language"
  ]
}
