{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "release_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "proposed": {
      "default": false,
      "type": "boolean"
    },
    "timezone": {
      "type": "string",
      "minLength": 1
    },
    "events": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "at": {
            "type": "string",
            "minLength": 1
          },
          "platform": {
            "type": "string",
            "enum": [
              "distributor",
              "spotify",
              "youtube",
              "shorts",
              "tiktok",
              "instagram",
              "x",
              "linkedin",
              "microsite"
            ]
          },
          "step": {
            "type": "string",
            "minLength": 1
          },
          "item": {
            "default": "main",
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "at",
          "platform",
          "step"
        ]
      }
    }
  },
  "required": [
    "version",
    "project",
    "title",
    "release_date",
    "timezone"
  ]
}
