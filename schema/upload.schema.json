{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "language": {
      "type": "string",
      "minLength": 2
    },
    "main": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "tags": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "hashtags": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^#[\\p{L}\\p{N}_]+$"
          }
        },
        "thumbnail": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "type": "string",
          "minLength": 2
        },
        "made_for_kids": {
          "default": false,
          "type": "boolean"
        },
        "synthetic_media": {
          "default": true,
          "type": "boolean"
        },
        "category_id": {
          "default": "10",
          "type": "string",
          "pattern": "^\\d+$"
        },
        "chapters": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "start": {
                "type": "number",
                "minimum": 0
              },
              "title": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "start",
              "title"
            ]
          }
        },
        "pinned_comment": {
          "type": "string",
          "minLength": 1
        },
        "community_post": {
          "type": "string",
          "minLength": 1
        },
        "summary_en": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1
            },
            "description": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "title",
            "description"
          ]
        },
        "alternate_thumbnails": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "platforms": {
          "default": [
            "youtube"
          ],
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "youtube",
              "tiktok"
            ]
          }
        }
      },
      "required": [
        "file",
        "title",
        "description",
        "hashtags"
      ]
    },
    "shorts": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
          },
          "moment": {
            "type": "string",
            "minLength": 1
          },
          "file": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "tags": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "hashtags": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^#[\\p{L}\\p{N}_]+$"
            }
          },
          "thumbnail": {
            "type": "string",
            "minLength": 1
          },
          "language": {
            "type": "string",
            "minLength": 2
          },
          "made_for_kids": {
            "default": false,
            "type": "boolean"
          },
          "synthetic_media": {
            "default": true,
            "type": "boolean"
          },
          "category_id": {
            "default": "10",
            "type": "string",
            "pattern": "^\\d+$"
          },
          "related": {
            "default": "main",
            "type": "string",
            "const": "main"
          },
          "platforms": {
            "default": [
              "youtube",
              "tiktok"
            ],
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "youtube",
                "tiktok"
              ]
            }
          },
          "instagram": {
            "type": "object",
            "properties": {
              "caption": {
                "type": "string",
                "minLength": 1
              },
              "hashtags": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^#[\\p{L}\\p{N}_]+$"
                }
              },
              "cover_frame": {
                "type": "number",
                "minimum": 0
              },
              "story": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "caption"
            ]
          },
          "tiktok": {
            "type": "object",
            "properties": {
              "caption": {
                "type": "string",
                "minLength": 1
              },
              "hashtags": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^#[\\p{L}\\p{N}_]+$"
                }
              },
              "overlay": {
                "type": "string",
                "minLength": 1
              },
              "pinned_comment": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "caption"
            ]
          },
          "x": {
            "type": "object",
            "properties": {
              "post": {
                "type": "string",
                "minLength": 1
              },
              "hashtags": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^#[\\p{L}\\p{N}_]+$"
                }
              }
            },
            "required": [
              "post"
            ]
          },
          "summary_en": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "title",
              "description"
            ]
          }
        },
        "required": [
          "name",
          "file",
          "title",
          "description",
          "hashtags"
        ]
      }
    },
    "instagram_post": {
      "type": "object",
      "properties": {
        "caption": {
          "type": "string",
          "minLength": 1
        },
        "hashtags": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^#[\\p{L}\\p{N}_]+$"
          }
        }
      },
      "required": [
        "caption"
      ]
    },
    "spotify": {
      "type": "object",
      "properties": {
        "artist_pick": {
          "type": "string",
          "minLength": 1
        },
        "pitch": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "announcement": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "hashtags": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^#[\\p{L}\\p{N}_]+$"
          }
        }
      },
      "required": [
        "text"
      ]
    },
    "x": {
      "type": "object",
      "properties": {
        "post": {
          "type": "string",
          "minLength": 1
        },
        "hashtags": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^#[\\p{L}\\p{N}_]+$"
          }
        },
        "reply": {
          "type": "string",
          "minLength": 1
        },
        "media": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "post"
      ]
    },
    "linkedin": {
      "type": "object",
      "properties": {
        "decision": {
          "type": "string",
          "enum": [
            "post",
            "skip"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "post": {
          "type": "string",
          "minLength": 1
        },
        "hashtags": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^#[\\p{L}\\p{N}_]+$"
          }
        },
        "media": {
          "default": "main",
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "decision",
        "reason"
      ]
    },
    "microsite": {
      "type": "object",
      "properties": {
        "teaser": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "quote": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "teaser",
        "text"
      ]
    }
  },
  "required": [
    "version",
    "language",
    "main"
  ]
}
