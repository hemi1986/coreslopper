# Copy to .env and fill in the values you need.
# The mock provider and the motion-only demo need no secrets.

# Required for real fal.ai image/video generation.
FAL_KEY=

# Required for real Higgsfield image/video generation. Use either the complete
# credential copied from https://open.higgsfield.ai or split ID and secret.
# HF_API_KEY, HF_KEY, and HF_CREDENTIALS are accepted as aliases.
HIGGSFIELD_API_KEY=
HF_API_KEY_ID=
HF_API_KEY_SECRET=

# Optional: local video clips through ComfyUI (providers.video: comfyui).
# Workflows live in comfyui/workflows/; see comfyui/README.md.
COMFYUI_URL=http://127.0.0.1:8188
# COMFYUI_TIMEOUT_MS=3600000
# COMFYUI_WORKFLOWS_DIR=

# Optional: keep large media (assets/, renders/) outside the repository, for
# example on a Windows drive. `{slug}` is the project slug; without it the slug
# is appended. New projects are linked automatically; move an existing one with
# `npm run cli -- media-link projects/<slug> --move`.
# CORESLOPPER_MEDIA_DIR=/mnt/d/{slug}

# Optional: render memory limits (defaults shown). Remotion's own defaults use
# half of the free RAM per cache, which can exhaust a WSL VM.
# CORESLOPPER_RENDER_CONCURRENCY=4   (clamped to 2–4; 3D shots use 1)
# CORESLOPPER_VIDEO_CACHE_MB=2048
# CORESLOPPER_MEDIA_CACHE_MB=512
# CORESLOPPER_SEGMENT_SECONDS=60

# Optional: only if you add an API speech-recognition adapter.
OPENAI_API_KEY=

# Optional: gated Hugging Face models used by some Demucs/WhisperX setups.
HF_TOKEN=

# Audio-analysis flags are CLI arguments: --device, --demucs-model, --whisper-model.
