{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "minLength": 1
    },
    "files": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "video",
              "subtitles",
              "thumbnail",
              "short",
              "short-thumbnail",
              "tiktok-cover",
              "audio",
              "cover",
              "canvas",
              "lyrics",
              "text",
              "readme",
              "calendar",
              "microsite"
            ]
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "spec": {
            "default": {},
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "source": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "path",
          "kind",
          "bytes",
          "sha256",
          "source"
        ]
      }
    },
    "todos": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "version",
    "project",
    "generated_at"
  ]
}
