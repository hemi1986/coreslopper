{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "default": 1,
      "type": "number",
      "const": 1
    },
    "bpm": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "beats": {
      "type": "array",
      "items": {
        "type": "number",
        "minimum": 0
      }
    },
    "downbeats": {
      "type": "array",
      "items": {
        "type": "number",
        "minimum": 0
      }
    },
    "sections": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "start": {
            "type": "number",
            "minimum": 0
          },
          "end": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "id",
          "start",
          "end"
        ]
      }
    },
    "lines": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "start": {
            "type": "number",
            "minimum": 0
          },
          "end": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "id",
          "start",
          "end"
        ]
      }
    },
    "words": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "line": {
            "type": "string",
            "minLength": 1
          },
          "index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "start": {
            "type": "number",
            "minimum": 0
          },
          "end": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "line",
          "index",
          "start",
          "end"
        ]
      }
    }
  }
}
