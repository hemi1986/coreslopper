{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "workflowVersion": {
      "type": "string",
      "minLength": 1
    },
    "stage": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "running",
        "done",
        "failed",
        "skipped"
      ]
    },
    "stages": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "running",
              "done",
              "failed",
              "skipped"
            ]
          },
          "inputHash": {
            "type": "string"
          },
          "outputs": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "attempts": {
            "default": 0,
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "lastError": {
            "type": "string"
          },
          "startedAt": {
            "type": "string"
          },
          "finishedAt": {
            "type": "string"
          }
        },
        "required": [
          "status"
        ]
      }
    },
    "budget": {
      "type": "object",
      "properties": {
        "totalUsd": {
          "type": "number",
          "minimum": 0
        },
        "spentUsd": {
          "type": "number",
          "minimum": 0
        },
        "reservedUsd": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "totalUsd",
        "spentUsd",
        "reservedUsd"
      ]
    },
    "artifacts": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "errors": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "updatedAt": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "version",
    "project",
    "workflowVersion",
    "stage",
    "status",
    "stages",
    "budget",
    "updatedAt"
  ]
}
