# Copy to .env and fill in the values you need.
# The mock provider and the motion-only demo need no secrets.

# Required for real fal.ai image/video generation.
FAL_KEY=

# Required for real Higgsfield image/video generation. Use either the complete
# credential copied from https://open.higgsfield.ai or split ID and secret.
# HF_API_KEY, HF_KEY, and HF_CREDENTIALS are accepted as aliases.
HIGGSFIELD_API_KEY=
HF_API_KEY_ID=
HF_API_KEY_SECRET=

# Required for real Topview image/video generation: the platform API key from
# https://platform.topview.ai/api-keys (TOPVIEW_API_KEY is accepted as an alias).
TOPVIEW_API_PLATFORM_KEY=

# Optional, only for Topview lip-sync (providers.lipsync: topview, Avatar 4):
# the Topview OpenAPI uid and key from topview.ai > API Settings. They are
# separate from the platform key and bill Topview plan credits.
TOPVIEW_UID=
TOPVIEW_OPENAPI_KEY=

# Optional: `publish` uploads the release package (docs/publishing.md).
# YouTube: an OAuth client of type "Desktop app" from Google Cloud with the
# YouTube Data API v3 enabled. The refresh token is written by
# `npm run cli -- publish-auth youtube`; never paste it anywhere else.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
# YOUTUBE_DAILY_QUOTA=10000   (raise only after Google granted more quota)
# TikTok: an app with Login Kit and the Content Posting API (scope video.upload).
# The refresh token is written by `npm run cli -- publish-auth tiktok`.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REFRESH_TOKEN=
# TIKTOK_REDIRECT_URI=http://localhost:8765/callback/   (must match the portal)
# TIKTOK_DIRECT_POST=1   (only after TikTok audited the app: asks for video.publish)

# Optional: the release autopilot posts approved releases at their calendar
# times (docs/publishing.md, "Release autopilot"). Each platform is optional;
# a missing one stays manual on the release board. The tokens are written by
# `npm run cli -- publish-auth x|linkedin|instagram`.
# X: an app with OAuth 2.0 (confidential client), callback http://127.0.0.1:8767/callback.
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REFRESH_TOKEN=
# LinkedIn: an app with "Share on LinkedIn" and "Sign In with LinkedIn using OpenID Connect",
# redirect URL http://localhost:8766/callback. The token lasts 60 days.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_TOKEN_EXPIRES_AT=
LINKEDIN_MEMBER_URN=
# Instagram: the token the Meta app dashboard generates for your professional account
# (publish-auth instagram asks for it). Instagram fetches files from a public URL,
# so the autopilot also needs FAL_KEY (fal.ai storage).
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
INSTAGRAM_TOKEN_EXPIRES_AT=

# Optional: local video clips through ComfyUI (providers.video: comfyui).
# Workflows live in comfyui/workflows/; see comfyui/README.md.
COMFYUI_URL=http://127.0.0.1:8188
# COMFYUI_TIMEOUT_MS=3600000
# COMFYUI_WORKFLOWS_DIR=
# Command that restarts your ComfyUI server; `comfy restart` and `queue run` use it.
# COMFYUI_RESTART_COMMAND=.local/comfyui-restart.sh

# Optional: keep large media (assets/, renders/) outside the repository, for
# example on a Windows drive. `{slug}` is the project slug; without it the slug
# is appended. New projects are linked automatically; move an existing one with
# `npm run cli -- media-link projects/<slug> --move`.
# CORESLOPPER_MEDIA_DIR=/mnt/d/{slug}

# Optional: render memory limits (defaults shown). Remotion's own defaults use
# half of the free RAM per cache, which can exhaust a WSL VM.
# CORESLOPPER_RENDER_CONCURRENCY=4   (clamped to 2–4; 3D shots use 1)
# CORESLOPPER_VIDEO_CACHE_MB=2048
# CORESLOPPER_MEDIA_CACHE_MB=512
# CORESLOPPER_SEGMENT_SECONDS=60

# Optional: only if you add an API speech-recognition adapter.
OPENAI_API_KEY=

# Optional: gated Hugging Face models used by some Demucs/WhisperX setups.
HF_TOKEN=

# Audio-analysis flags are CLI arguments: --device, --demucs-model, --whisper-model.
