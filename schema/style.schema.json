{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "default": 1,
      "type": "number",
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "palette": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^#[0-9a-fA-F]{6}$"
      }
    },
    "roles": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "typography": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "family": {
            "type": "string",
            "minLength": 1
          },
          "weight": {
            "type": "integer",
            "minimum": 100,
            "maximum": 900
          },
          "size": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "letterSpacing": {
            "type": "number"
          },
          "lineHeight": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "required": [
          "family"
        ]
      }
    },
    "look": {
      "default": {
        "keywords": [],
        "negative": [],
        "references": []
      },
      "type": "object",
      "properties": {
        "keywords": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "negative": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "references": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "motion": {
      "default": {
        "easing": "easeOut",
        "grain": 0.08
      },
      "type": "object",
      "properties": {
        "easing": {
          "default": "easeOut",
          "type": "string"
        },
        "grain": {
          "default": 0.08,
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  },
  "required": [
    "name",
    "palette",
    "typography"
  ]
}
