# Dependencies
node_modules/
.pnpm-store/
.agents/

# Build output
dist/
build/
coverage/
.remotion/
runtime/
*.tgz

# Secrets and local config
.env
.env.*
!.env.example

# Caches and local tools
.cache/
.tools/
.vitest/
*.log

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Project media (text artifacts stay tracked)
projects/*/audio/*
!projects/*/audio/.gitkeep
projects/*/assets/*
!projects/*/assets/.gitkeep
projects/*/characters/*
!projects/*/characters/.gitkeep
projects/*/renders/*
!projects/*/renders/.gitkeep
projects/*/timing.effective.json

# Series canon media (references, reference voices); the YAML canon stays tracked
series/*/characters/*
!series/*/characters/.gitkeep
series/*/sets/*
!series/*/sets/.gitkeep

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# Temporary
tmp/
