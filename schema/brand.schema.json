{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "default": 1,
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "logo": {
      "type": "string",
      "minLength": 1
    },
    "tokens": {
      "type": "string",
      "minLength": 1
    },
    "palette": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^#[0-9a-fA-F]{6}$"
      }
    },
    "typography": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "family": {
            "type": "string",
            "minLength": 1
          },
          "weight": {
            "type": "integer",
            "minimum": 100,
            "maximum": 900
          },
          "size": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "letterSpacing": {
            "type": "number"
          },
          "lineHeight": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "required": [
          "family"
        ]
      }
    },
    "motion": {
      "type": "object",
      "properties": {
        "easing": {
          "default": "easeOut",
          "type": "string"
        },
        "grain": {
          "default": 0.08,
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "fonts": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "family": {
            "type": "string",
            "minLength": 1
          },
          "file": {
            "type": "string",
            "minLength": 1
          },
          "license": {
            "type": "string",
            "minLength": 1
          },
          "weight": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000
              },
              {
                "type": "string",
                "minLength": 1
              }
            ]
          },
          "style": {
            "type": "string",
            "enum": [
              "normal",
              "italic"
            ]
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "family",
          "file",
          "license"
        ]
      }
    }
  },
  "required": [
    "id",
    "name",
    "logo",
    "tokens",
    "palette",
    "typography",
    "motion"
  ]
}
