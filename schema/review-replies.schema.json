{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "round": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "answered_at": {
      "type": "string",
      "minLength": 1
    },
    "render": {
      "type": "string"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "fixed",
              "partly",
              "not-fixed",
              "question"
            ]
          },
          "reply": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "status",
          "reply"
        ]
      }
    }
  },
  "required": [
    "version",
    "round",
    "answered_at",
    "notes"
  ]
}
