{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "language": {
      "type": "string",
      "minLength": 2
    },
    "main": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "tags": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "hashtags": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^#[\\p{L}\\p{N}_]+$"
          }
        },
        "thumbnail": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "type": "string",
          "minLength": 2
        },
        "made_for_kids": {
          "default": false,
          "type": "boolean"
        },
        "synthetic_media": {
          "default": true,
          "type": "boolean"
        },
        "category_id": {
          "default": "10",
          "type": "string",
          "pattern": "^\\d+$"
        },
        "alternate_thumbnails": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "platforms": {
          "default": [
            "youtube"
          ],
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "youtube",
              "tiktok"
            ]
          }
        }
      },
      "required": [
        "file",
        "title",
        "description",
        "hashtags"
      ]
    },
    "shorts": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
          },
          "moment": {
            "type": "string",
            "minLength": 1
          },
          "file": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "tags": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "hashtags": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^#[\\p{L}\\p{N}_]+$"
            }
          },
          "thumbnail": {
            "type": "string",
            "minLength": 1
          },
          "language": {
            "type": "string",
            "minLength": 2
          },
          "made_for_kids": {
            "default": false,
            "type": "boolean"
          },
          "synthetic_media": {
            "default": true,
            "type": "boolean"
          },
          "category_id": {
            "default": "10",
            "type": "string",
            "pattern": "^\\d+$"
          },
          "related": {
            "default": "main",
            "type": "string",
            "const": "main"
          },
          "platforms": {
            "default": [
              "youtube",
              "tiktok"
            ],
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "youtube",
                "tiktok"
              ]
            }
          }
        },
        "required": [
          "name",
          "file",
          "title",
          "description",
          "hashtags"
        ]
      }
    }
  },
  "required": [
    "version",
    "language",
    "main"
  ]
}
