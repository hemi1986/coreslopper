{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "round": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "video": {
      "type": "string",
      "minLength": 1
    },
    "fps": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "submitted_at": {
      "type": "string",
      "minLength": 1
    },
    "notes": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "frame": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "seconds": {
            "type": "number",
            "minimum": 0
          },
          "time": {
            "type": "string"
          },
          "end_frame": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "end_seconds": {
            "type": "number",
            "minimum": 0
          },
          "end_time": {
            "type": "string"
          },
          "shots": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "section": {
            "type": "string"
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "frame",
          "seconds",
          "time",
          "text"
        ]
      }
    }
  },
  "required": [
    "version",
    "round",
    "video",
    "fps",
    "submitted_at",
    "notes"
  ]
}
