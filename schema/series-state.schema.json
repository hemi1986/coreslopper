{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "series": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "budget": {
      "type": "object",
      "properties": {
        "totalUsd": {
          "type": "number",
          "minimum": 0
        },
        "spentUsd": {
          "type": "number",
          "minimum": 0
        },
        "reservedUsd": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "totalUsd",
        "spentUsd",
        "reservedUsd"
      ]
    },
    "updatedAt": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "version",
    "series",
    "budget",
    "updatedAt"
  ]
}
